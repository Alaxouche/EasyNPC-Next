<UserControl x:Class="Focus.Apps.EasyNpc.Profiles.MugshotViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:fa5="http://schemas.fontawesome.com/icons/"
             xmlns:local="clr-namespace:Focus.Apps.EasyNpc.Profiles"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=local:MugshotViewModel}"
             d:DesignHeight="450" d:DesignWidth="800">
    <StackPanel x:Name="Root" Width="176" Margin="5,8">
        <!-- The mugshot itself, framed as a card so faces (and the silhouette placeholder) read clearly against the
             background instead of floating on black. -->
        <Grid x:Name="ImageContainer">
            <Border x:Name="CardBorder" Height="160" CornerRadius="8">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}"/>
                        <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundListLowBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMouseOver, ElementName=ImageContainer}" Value="True">
                                <Setter Property="BorderBrush"
                                        Value="{DynamicResource SystemControlHighlightBaseMediumHighBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSelectedSource}" Value="True">
                                <Setter Property="BorderThickness" Value="3"/>
                                <Setter Property="BorderBrush"
                                        Value="{DynamicResource SystemControlHighlightAccentBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <!-- Round the image to match the card corners. HighQuality scaling avoids the jagged edges the
                     default bitmap scaling produced on the high-resolution silhouette placeholder. -->
                <Border CornerRadius="7" ClipToBounds="True">
                    <Image Source="{Binding DisplaySource}" Stretch="Uniform" StretchDirection="DownOnly"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
            </Border>
            <!-- "Vanilla" tag for the base game card, so it's easy to spot the reset-to-vanilla option. -->
            <Border Background="{DynamicResource SystemControlBackgroundBaseMediumBrush}"
                    CornerRadius="6" Padding="7,2" Margin="8" HorizontalAlignment="Left" VerticalAlignment="Top"
                    Visibility="{Binding IsBaseGame, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Vanilla" FontSize="10" FontWeight="SemiBold"
                           Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
            </Border>
            <!-- Selected-source badge. -->
            <Border Background="{DynamicResource SystemControlHighlightAccentBrush}" Width="30" Height="30"
                    CornerRadius="15" Margin="8" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Visibility="{Binding IsSelectedSource, Converter={StaticResource BoolToVisibility}}">
                <fa5:SvgAwesome Icon="Solid_Check" Foreground="White" Width="14" Height="14"/>
            </Border>
            <!-- Open-on-Nexus button. Fades in when the card is hovered, so it doesn't clutter the gallery. -->
            <Button Click="NexusLink_Click" Cursor="Hand" Margin="6" Width="26" Height="26"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom" ToolTip="Open this mod on Nexus"
                    Visibility="{Binding HasNexusLink, Converter={StaticResource BoolToVisibility}}">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Opacity" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bg" Background="#B0202020" CornerRadius="13">
                                        <fa5:SvgAwesome Icon="Solid_ExternalLinkAlt" Width="11" Height="11"
                                                        Foreground="White" HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bg" Property="Background" Value="#E0000000"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMouseOver, ElementName=ImageContainer}" Value="True">
                                <Setter Property="Opacity" Value="0.9"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
        <!-- Label + status. -->
        <TextBlock Margin="2,8,2,0" ToolTip="{Binding Path=ModName, Mode=OneTime}"
                   TextTrimming="CharacterEllipsis">
            <Run FontWeight="SemiBold" Text="{Binding Path=ModName, Mode=OneWay}"/>
        </TextBlock>
        <ItemsControl Margin="2,0,2,0" ItemsSource="{Binding Path=InstalledPlugins}"
                      Visibility="{Binding IsPluginLoaded, Converter={StaticResource BoolToVisibility}}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" Foreground="{DynamicResource MutedTextBrush}"
                               TextTrimming="CharacterEllipsis"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <!-- Status warnings, each with a warning icon so they stand out. -->
        <StackPanel Margin="2,2,2,0">
            <StackPanel.Resources>
                <Style x:Key="StatusRow" TargetType="StackPanel">
                    <Setter Property="Orientation" Value="Horizontal"/>
                    <Setter Property="Margin" Value="0,1,0,0"/>
                </Style>
                <Style x:Key="StatusIcon" TargetType="fa5:SvgAwesome">
                    <Setter Property="Icon" Value="Solid_ExclamationTriangle"/>
                    <Setter Property="Width" Value="11"/>
                    <Setter Property="Height" Value="11"/>
                    <Setter Property="Margin" Value="0,0,5,0"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="Foreground" Value="{StaticResource WarningForegroundBrush}"/>
                </Style>
                <Style x:Key="StatusText" TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{StaticResource WarningForegroundBrush}"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                </Style>
            </StackPanel.Resources>
            <StackPanel Style="{StaticResource StatusRow}"
                        Visibility="{Binding IsModInstalled, Converter={StaticResource InvBoolToVisibility}}">
                <fa5:SvgAwesome Style="{StaticResource StatusIcon}"/>
                <TextBlock Style="{StaticResource StatusText}" Text="Mod not installed"/>
            </StackPanel>
            <StackPanel Style="{StaticResource StatusRow}"
                        Visibility="{Binding IsModDisabled, Converter={StaticResource BoolToVisibility}}">
                <fa5:SvgAwesome Style="{StaticResource StatusIcon}"/>
                <TextBlock Style="{StaticResource StatusText}" Text="Mod disabled"/>
            </StackPanel>
            <StackPanel Style="{StaticResource StatusRow}"
                        Visibility="{Binding IsDisabledByErrors, Converter={StaticResource BoolToVisibility}}">
                <fa5:SvgAwesome Style="{StaticResource StatusIcon}"/>
                <TextBlock Style="{StaticResource StatusText}" Text="Disabled due to errors"/>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
