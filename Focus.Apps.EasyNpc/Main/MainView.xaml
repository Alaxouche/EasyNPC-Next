<UserControl x:Class="Focus.Apps.EasyNpc.Main.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:config="clr-namespace:Focus.Apps.EasyNpc.Configuration"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:fa5="http://schemas.fontawesome.com/icons/"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:main="clr-namespace:Focus.Apps.EasyNpc.Main"
             xmlns:rpt="clr-namespace:Focus.Apps.EasyNpc.Reports"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=main:MainViewModel}"
             d:DesignHeight="720" d:DesignWidth="1200">
    <ContentControl x:Name="ContentControl" Content="{Binding Content}">
        <ContentControl.Resources>
            <DataTemplate DataType="{x:Type main:LoaderViewModel}">
                <main:Loader/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type main:MainViewModel}">
                <ui:NavigationView Header="{Binding SelectedNavigationMenuItem}"
                                   FooterMenuItemsSource="{Binding FooterNavigationMenuItems}"
                                   IsBackButtonVisible="Collapsed"
                                   MenuItemsSource="{Binding NavigationMenuItems}"
                                   PaneDisplayMode="Top"
                                   SelectedItem="{Binding SelectedNavigationMenuItem, Mode=TwoWay}"
                                   SelectionChanged="MainNavigationView_SelectionChanged">
                    <ui:NavigationView.HeaderTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,2">
                                <Border Width="4" CornerRadius="2" Margin="0,3,14,3"
                                        Background="{DynamicResource SystemControlHighlightAccentBrush}"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="26" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Description}" FontSize="13" Margin="0,-2,0,0"
                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ui:NavigationView.HeaderTemplate>
                    <ui:NavigationView.PaneHeader>
                        <!-- App wordmark + version badge, top-left. Marks the reworked build. -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,20,0">
                            <fa5:SvgAwesome Icon="Solid_TheaterMasks" Width="20" Height="20"
                                            Foreground="{DynamicResource SystemControlHighlightAccentBrush}"
                                            VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="{StaticResource AppTitle}" FontSize="17" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                            <Border Background="{DynamicResource SystemControlHighlightAccentBrush}"
                                    CornerRadius="9" Padding="8,1,8,2" Margin="10,1,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Source={StaticResource AppVersion}}" FontSize="11"
                                           FontWeight="SemiBold" Foreground="White"/>
                            </Border>
                        </StackPanel>
                    </ui:NavigationView.PaneHeader>
                    <ui:NavigationView.MenuItemTemplate>
                        <DataTemplate>
                            <ui:NavigationViewItem>
                                <ui:NavigationViewItem.Content>
                                    <StackPanel Orientation="Horizontal">
                                        <fa5:SvgAwesome Icon="{Binding Icon}" Width="16" Height="16"
                                                        VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ui:NavigationViewItem.Content>
                            </ui:NavigationViewItem>
                        </DataTemplate>
                    </ui:NavigationView.MenuItemTemplate>
                    <ui:Frame IsTabStop="True"
                              NavigationUIVisibility="Hidden"
                              Padding="12,0,12,24"
                              SourcePageType="{Binding SelectedNavigationMenuItem.PageType, Mode=TwoWay}"/>
                </ui:NavigationView>
            </DataTemplate>
            <DataTemplate DataType="{x:Type config:SettingsViewModel}">
                <ui:Frame DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                          Padding="12,0,12,24"
                          SourcePageType="{x:Type config:SettingsPage}"/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type rpt:StartupReportViewModel}">
                <DockPanel Margin="12,8">
                    <Border DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <ui:SimpleStackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                            <Button x:Name="ContinueButton"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Click="ContinueButton_Click">Continue to Profile</Button>
                        </ui:SimpleStackPanel>
                    </Border>
                    <rpt:StartupReport/>
                </DockPanel>
            </DataTemplate>
        </ContentControl.Resources>
    </ContentControl>
</UserControl>
